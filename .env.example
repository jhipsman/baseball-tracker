# Supabase — from `npx supabase status` (local) or Project Settings → API (hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by AI features (later phases).
ANTHROPIC_API_KEY=

# Team payments (Stripe Connect). Server-only. Use sk_test_… until you're ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect webhook pointing at /api/payments/webhook.
STRIPE_TEAM_WEBHOOK_SECRET=
# Full https address of the site (Stripe sends families back here after paying).
NEXT_PUBLIC_SITE_URL=

# Any long random string; Vercel Cron sends it to /api/cron/payment-reminders.
CRON_SECRET=
